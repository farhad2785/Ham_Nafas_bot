# ==============================
# 1. Backend (Django / Python)
# ==============================
# فایل‌های کش پایتون که به صورت خودکار ساخته می‌شوند
__pycache__/
*.py[cod]
*$py.class

# محیط‌های مجازی (اگر خارج از داکر هم تستی انجام دادید)
venv/
env/
.venv/

# فایل‌های آپلودی کاربران (مثل همان اکسل‌هایی که قرار است آپلود شوند)
backend/media/

# دیتابیس لوکال پیش‌فرض جنگو (ما از Postgres در داکر استفاده می‌کنیم اما برای اطمینان)
*.sqlite3
db.sqlite3

# ==============================
# 2. Frontend (Next.js / Node.js)
# ==============================
# پوشه حجیم پکیج‌های نود
node_modules/
frontend/node_modules/

# پوشه بیلد و کش Next.js
.next/
frontend/.next/
out/
build/

# لاگ‌های npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================
# 3. Environment Variables (Securities)
# ==============================
# بسیار مهم: فایل‌های حاوی رمز عبور دیتابیس و توکن‌ها هرگز نباید پوش شوند!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ==============================
# 4. Docker & Database Data
# ==============================
# اگر دیتای دیتابیس را به یک پوشه لوکال مَپ کرده‌اید، نباید در گیت ذخیره شود
postgres_data/
pgdata/
db_data/

# ==============================
# 5. OS & IDEs (VS Code, etc.)
# ==============================
# فایل‌های تنظیمات محیطی ادیتورها
.vscode/
.idea/
*.swp
*.swo

# فایل‌های کش سیستم عامل
.DS_Store
Thumbs.db